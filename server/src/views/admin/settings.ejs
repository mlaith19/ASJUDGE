<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="animated-bg">
  <%- include('../partials/header', { activePage: 'settings', username: typeof username !== 'undefined' ? username : 'admin' }) %>
  <main class="main-content" style="max-width: 800px;">
    <% if (locals.flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.message %></div>
    <% } %>
    <h1 class="mb-6">Settings</h1>
    <p class="updated mb-6">Global default WebView URL, polling interval, expected WiFi SSID, and app title / environment label. These apply to all tablets unless a tablet has a custom URL.</p>

    <div class="settings-section">
      <h3>General &amp; Network</h3>
      <p>Configure default WebView URL, polling, online timeout, and expected WiFi.</p>
      <form method="post" action="/admin/settings/update">
        <div class="settings-row">
          <div class="settings-label">
            <span>Default WebView URL</span>
            <small>Leave as <strong>auto</strong> and the tablets follow this server's own address, whatever DHCP gives it. A full http:// URL pins them to one machine.</small>
          </div>
          <!-- type="text", not "url": the browser refuses to submit the word
               "auto", which is the value this field should hold almost always.
               settingsService.js:45 accepts it and validates a real URL when one
               is given, so nothing is lost by letting the field say it. -->
          <input type="text" id="global_webview_url" name="global_webview_url" class="form-input" value="<%= (settings && settings.global_webview_url) || '' %>" placeholder="auto" style="width: 100%; max-width: 320px;">
        </div>
        <div class="settings-row">
          <div class="settings-label">
            <span>Polling interval (seconds)</span>
            <small>10–300</small>
          </div>
          <input type="number" id="polling_interval_seconds" name="polling_interval_seconds" class="form-input" value="<%= (settings && settings.polling_interval_seconds) || 25 %>" min="10" max="300" style="width: 100%; max-width: 120px;">
        </div>
        <div class="settings-row">
          <div class="settings-label">
            <span>Online timeout (seconds)</span>
            <small>Tablet is OFFLINE if no heartbeat within this time (15–300)</small>
          </div>
          <input type="number" id="judge_release_timeout_seconds" name="judge_release_timeout_seconds" class="form-input" value="<%= settings && settings.judge_release_timeout_seconds != null ? settings.judge_release_timeout_seconds : 60 %>" min="15" max="300" style="width: 100%; max-width: 120px;">
        </div>
        <div class="settings-row">
          <div class="settings-label">
            <span>Expected WiFi SSID</span>
            <small>Optional; used for “wrong network” warning</small>
          </div>
          <input type="text" id="expected_wifi_ssid" name="expected_wifi_ssid" class="form-input" value="<%= (settings && settings.expected_wifi_ssid) || '' %>" placeholder="e.g. JudgeLAN" maxlength="200" style="width: 100%; max-width: 220px;">
        </div>
        <div class="settings-row">
          <div class="settings-label">
            <span>App title</span>
            <small>Optional app title</small>
          </div>
          <input type="text" id="app_title" name="app_title" class="form-input" value="<%= (settings && settings.app_title) || '' %>" maxlength="200" style="width: 100%; max-width: 220px;">
        </div>
        <div class="settings-row">
          <div class="settings-label">
            <span>Environment label</span>
            <small>Optional environment label</small>
          </div>
          <input type="text" id="environment_label" name="environment_label" class="form-input" value="<%= (settings && settings.environment_label) || '' %>" maxlength="100" style="width: 100%; max-width: 220px;">
        </div>
        <div class="settings-row">
          <div class="settings-label">
            <span>Kiosk mode by default</span>
            <small>Enable kiosk mode for new tablets</small>
          </div>
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
            <input type="hidden" name="kiosk_mode_enabled_default" value="0">
            <input type="checkbox" name="kiosk_mode_enabled_default" value="1" <%= (settings && settings.kiosk_mode_enabled_default != null && settings.kiosk_mode_enabled_default != 0) ? 'checked' : '' %> style="width: auto; accent-color: var(--accent-emerald);">
            <span style="font-size: 0.875rem;">Enabled</span>
          </label>
        </div>
        <div class="flex justify-end" style="margin-top: 1.5rem;">
          <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Save settings
          </button>
        </div>
      </form>
    </div>
    <div class="settings-section" style="margin-top: 2rem;">
      <h3>Admin Tablet</h3>
      <p>Settings for tablets running in Admin View mode.</p>
      <form method="post" action="/admin/settings/update">
        <div class="settings-row">
          <div class="settings-label">
            <span>Admin alerts (vibrate + sound)</span>
            <small>When a judge connects, disconnects, or changes assignment, the admin tablet vibrates and plays a notification sound.</small>
          </div>
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
            <input type="hidden" name="admin_tablet_alerts_enabled" value="0">
            <input type="checkbox" name="admin_tablet_alerts_enabled" value="1" <%= (settings && (settings.admin_tablet_alerts_enabled == null || settings.admin_tablet_alerts_enabled != 0)) ? 'checked' : '' %> style="width: auto; accent-color: var(--accent-emerald);">
            <span style="font-size: 0.875rem;">Enabled</span>
          </label>
        </div>
        <div class="flex justify-end" style="margin-top: 1.5rem;">
          <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Save
          </button>
        </div>
      </form>
    </div>
    <div class="settings-section" style="margin-top: 2rem;">
      <h3>Telegram Notifications</h3>
      <p>Receive a Telegram message on your phone whenever a judge connects, disconnects, is assigned, logs in/out, or has a low battery.</p>

      <div style="background: var(--bg-card, #1e293b); border: 1px solid var(--border, #334155); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; font-size: 0.85rem; line-height: 1.7;">
        <strong>How to set up (one time):</strong>
        <ol style="margin: 0.5rem 0 0 1.2rem; padding: 0;">
          <li>Open Telegram and search for <strong>@BotFather</strong></li>
          <li>Send <code>/newbot</code>, choose a name, and copy the <strong>Bot Token</strong></li>
          <li>Search for your new bot in Telegram and send it any message (e.g. <code>hello</code>)</li>
          <li>Open this URL in a browser to find your <strong>Chat ID</strong>:<br>
            <code style="word-break:break-all;">https://api.telegram.org/bot<strong>TOKEN</strong>/getUpdates</code><br>
            Look for <code>"chat":{"id": <strong>123456789</strong>}</code> — that number is your Chat ID</li>
          <li>Paste the Bot Token and Chat ID below, save, then click <strong>Send test</strong></li>
        </ol>
      </div>

      <form method="post" action="/admin/settings/update">
        <div class="settings-row">
          <div class="settings-label">
            <span>Bot Token</span>
            <small>From @BotFather (e.g. 123456:ABC-DEF...)</small>
          </div>
          <input type="password" id="telegram_bot_token" name="telegram_bot_token"
            class="form-input"
            value="<%= (settings && settings.telegram_bot_token) || '' %>"
            placeholder="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
            autocomplete="off"
            style="width: 100%; max-width: 340px;">
        </div>
        <div class="settings-row">
          <div class="settings-label">
            <span>Chat ID</span>
            <small>Your personal Telegram Chat ID (a number)</small>
          </div>
          <div style="display:flex; flex-direction:column; gap:0.5rem; max-width:340px; width:100%;">
            <div style="display:flex; gap:0.5rem; align-items:center;">
              <input type="text" id="telegram_chat_id" name="telegram_chat_id"
                class="form-input"
                value="<%= (settings && settings.telegram_chat_id) || '' %>"
                placeholder="123456789"
                maxlength="100"
                autocomplete="off"
                style="flex:1; min-width:0;">
              <button type="button" id="get_chat_id_btn" class="btn" onclick="fetchChatId()" style="white-space:nowrap; flex-shrink:0;">
                Get my Chat ID
              </button>
            </div>
            <div id="chat_id_result" style="display:none; font-size:0.82rem; padding: 0.4rem 0.6rem; border-radius:6px;"></div>
          </div>
        </div>
        <div class="flex justify-end" style="margin-top: 1.5rem; gap: 0.75rem;">
          <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Save
          </button>
        </div>
      </form>
      <form method="post" action="/admin/settings/telegram-test" style="margin-top: 0.75rem;">
        <div class="flex justify-end">
          <button type="submit" class="btn" style="background: var(--accent-sky, #0ea5e9); color: #fff;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            Send test message
          </button>
        </div>
      </form>
    </div>

  </main>
  <script>
  async function fetchChatId() {
    const btn = document.getElementById('get_chat_id_btn');
    const result = document.getElementById('chat_id_result');
    btn.disabled = true;
    btn.textContent = 'Loading...';
    result.style.display = 'none';
    try {
      const res = await fetch('/admin/settings/telegram-updates');
      const data = await res.json();
      if (!data.ok) {
        result.style.background = 'rgba(239,68,68,0.15)';
        result.style.color = '#f87171';
        result.textContent = 'Error: ' + (data.description || data.error || 'Unknown');
        result.style.display = 'block';
        return;
      }
      const updates = data.result || [];
      const seen = {};
      updates.forEach(u => {
        const chat = (u.message || u.edited_message || u.channel_post || {}).chat;
        if (chat && chat.id) seen[chat.id] = chat;
      });
      const chats = Object.values(seen);
      if (chats.length === 0) {
        result.style.background = 'rgba(245,158,11,0.15)';
        result.style.color = '#fbbf24';
        result.textContent = 'No messages found. Open Telegram, find your bot and send it any message, then click Get my Chat ID again.';
        result.style.display = 'block';
        return;
      }
      if (chats.length === 1) {
        document.getElementById('telegram_chat_id').value = chats[0].id;
        result.style.background = 'rgba(16,185,129,0.15)';
        result.style.color = '#34d399';
        result.textContent = 'Chat ID ' + chats[0].id + ' filled automatically.';
      } else {
        result.style.background = 'rgba(99,102,241,0.1)';
        result.style.color = 'inherit';
        result.innerHTML = 'Multiple chats found — click to fill: ' +
          chats.map(c => '<a href="#" style="color:var(--accent-sky,#38bdf8)" onclick="document.getElementById(\'telegram_chat_id\').value=\'' + c.id + '\';return false;">' + c.id + ' (' + (c.first_name || c.username || c.title || 'Unknown') + ')</a>').join(', ');
      }
      result.style.display = 'block';
    } catch(e) {
      result.style.background = 'rgba(239,68,68,0.15)';
      result.style.color = '#f87171';
      result.textContent = 'Request failed: ' + e.message;
      result.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Get my Chat ID';
    }
  }
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <%- include('../partials/admin-notifications') %>
</body>
</html>
