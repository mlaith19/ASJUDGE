<%- include('layouts/main', { body: `
<div class="page-header">
  <h1>Global Settings</h1>
  <p class="text-muted">Configure system-wide settings for all tablets</p>
</div>

<div class="settings-card">
  <form method="POST" action="/admin/settings/update" class="settings-form">
    <div class="form-group">
      <label for="global_webview_url">Global Default WebView URL</label>
      <input type="url" id="global_webview_url" name="global_webview_url"
             value="${settings.global_webview_url}" class="form-input" required
             placeholder="http://192.168.10.100">
      <small class="form-help">This URL will be loaded by all tablets that don't have a custom URL set</small>
    </div>

    <div class="form-group">
      <label for="polling_interval_seconds">Polling Interval (seconds)</label>
      <input type="number" id="polling_interval_seconds" name="polling_interval_seconds"
             value="${settings.polling_interval_seconds}" class="form-input" required
             min="5" max="300">
      <small class="form-help">How often tablets sync with the server (5-300 seconds)</small>
    </div>

    <div class="form-group">
      <label for="app_title">App Title</label>
      <input type="text" id="app_title" name="app_title"
             value="${settings.app_title}" class="form-input"
             placeholder="Arabian Show Judge">
    </div>

    <div class="form-group">
      <label for="environment_label">Environment Label</label>
      <input type="text" id="environment_label" name="environment_label"
             value="${settings.environment_label || ''}" class="form-input"
             placeholder="e.g. Development, Production, Show Hall A">
    </div>

    <button type="submit" class="btn btn-primary">Save Settings</button>
  </form>
</div>

<div class="settings-info">
  <h3>Current Configuration</h3>
  <div class="info-grid">
    <div class="info-item">
      <span class="info-label">WebView URL</span>
      <span class="info-value">${settings.global_webview_url}</span>
    </div>
    <div class="info-item">
      <span class="info-label">Polling Interval</span>
      <span class="info-value">${settings.polling_interval_seconds}s</span>
    </div>
    <div class="info-item">
      <span class="info-label">Last Updated</span>
      <span class="info-value">${settings.updated_at || '—'}</span>
    </div>
  </div>
</div>
`}) %>
