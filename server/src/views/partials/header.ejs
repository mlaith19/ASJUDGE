<header class="header">
  <div class="flex items-center gap-4">
    <div class="header-logo">
      <img src="/logo.png" alt="Arabian Show Judge" class="admin-logo">
      <span style="background: linear-gradient(135deg, #f59e0b, #eab308); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 700;">A.S JUDGE</span>
    </div>
    <nav class="header-nav">
      <a href="/admin/dashboard" class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
        Judge Control
      </a>
      <a href="/admin/judges" class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'judges' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Judges
      </a>
      <a href="/admin/tablets" class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'tablets' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
        Tablets
      </a>
      <a href="/admin/settings" class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'settings' ? ' active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4"></path></svg>
        Settings
      </a>
    </nav>
  </div>
  <div class="header-user" style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: nowrap;">
    <div class="user-badge">
      <div class="user-avatar"><%= typeof username !== 'undefined' && username ? String(username).charAt(0).toUpperCase() : 'A' %></div>
      <span><%= typeof username !== 'undefined' ? username : 'admin' %></span>
    </div>
    <form method="post" action="/admin/logout" style="display:inline;">
      <button type="submit" class="btn-logout" style="background:none;border:none;cursor:pointer;display:flex;align-items:center;gap:0.35rem;padding:0.3rem 0.6rem;color:var(--text-muted);font-size:0.75rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Logout
      </button>
    </form>
  </div>
</header>
