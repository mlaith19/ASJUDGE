# Backend API - change for production
PORT=5000
NODE_ENV=development

# Session secret - generate a strong random string for production
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Database path (SQLite file)
DATABASE_PATH=./data/tablet_monitor.db

# LAN IP - set this to your server's LAN IP for tablet app config
# Example: BACKEND_BASE_URL=http://192.168.10.100:5000
BACKEND_BASE_URL=http://192.168.10.100:5000
